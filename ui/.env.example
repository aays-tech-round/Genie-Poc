# Copy this file to .env.local and fill in the values.
# Microsoft Entra ID - SPA app registration (public client, no secret)
NEXT_PUBLIC_SSO_CLIENT_ID=
NEXT_PUBLIC_SSO_AUTHORITIES=https://login.microsoftonline.com/<tenant-id>
# Optional; only for B2C / ADFS / custom authorities. Leave empty for standard Entra ID.
NEXT_PUBLIC_SSO_KNOWN_AUTHORITIES=
NEXT_PUBLIC_SSO_API_SCOPE=
