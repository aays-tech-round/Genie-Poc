# Copy this file to .env.local and fill in the values.
# Microsoft Entra ID - SPA app registration (public client, no secret)
VITE_SSO_CLIENT_ID=
VITE_SSO_AUTHORITIES=https://login.microsoftonline.com/<tenant-id>
# Optional; only for B2C / ADFS / custom authorities. Leave empty for standard Entra ID.
VITE_SSO_KNOWN_AUTHORITIES=
VITE_SSO_API_SCOPE=

# Genie backend (FastAPI app in ../app). Defaults to the local dev server.
VITE_GENIE_API_BASE_URL=http://localhost:8000/api/v1/genie
