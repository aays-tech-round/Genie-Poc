# Copy this file to .env and fill in the values. Never commit .env.
# Databricks workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=
# Service principal (OAuth M2M) credentials
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Genie Space the backend queries
GENIE_SPACE_ID=
# SQL warehouse attached to the Genie Space
DATABRICKS_WAREHOUSE_ID=
