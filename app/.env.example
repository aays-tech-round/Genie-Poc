# Copy this file to .env and fill in the values. Never commit .env.
# Databricks workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=
# Service principal (OAuth M2M) credentials
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Genie Space the backend queries
GENIE_SPACE_ID=
# SQL warehouse attached to the Genie Space
DATABRICKS_WAREHOUSE_ID=

# --- Sign-in: validates the Entra ID access token the frontend sends (auth.py) ---
# Directory (tenant) ID
ENTRA_TENANT_ID=
# This API's Application ID URI, e.g. api://<client-id> (the bare client ID also works)
ENTRA_API_AUDIENCE=
# Delegated scope the token must carry (default access_as_user)
ENTRA_REQUIRED_SCOPE=access_as_user
# Optional app role users need, e.g. Genie.User. Empty = any user in the tenant.
ENTRA_ALLOWED_ROLE=
# Keep true. "false" only works together with APP_ENV=local (offline development).
AUTH_ENABLED=true
# "local" on a developer machine; leave unset or set to dev/test/prod when deployed.
APP_ENV=
# Frontend origins allowed to call this API from a browser, comma-separated
CORS_ORIGINS=http://localhost:5173
